# Adaptive AI Agent environment reference
#
# Copy the relevant entries into Replit Secrets / environment variables.
# Never commit real values. The client-safe Firebase values are bundled into
# the browser by Vite; every other secret below must remain server-only.

# ---------------------------------------------------------------------------
# CLIENT-SAFE: Firebase Web SDK configuration
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id

# ---------------------------------------------------------------------------
# SERVER-ONLY: Firebase Admin and AI services
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=replace-with-firebase-admin-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-admin-client-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-admin-private-key

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

QDRANT_URL=https://replace-with-qdrant-endpoint
QDRANT_API_KEY=replace-with-qdrant-api-key

# Leave empty for same-origin requests. Use comma-separated origins only when
# an explicitly separate trusted frontend origin needs to call the API.
CORS_ORIGINS=

# Optional server tuning
LOG_LEVEL=info
MEMORY_RETRIEVAL_TOP_K=3
MEMORY_RETRIEVAL_THRESHOLD=0.65

# ---------------------------------------------------------------------------
# WORKFLOW / VERIFICATION VALUES
# ---------------------------------------------------------------------------
# The artifact workflows provide PORT and BASE_PATH automatically.
# NODE_ENV=production is supplied by the API production build/run config.
# PHASE9_BASE_URL is used only by the live Phase 9 boundary-check command.
# PHASE9_BASE_URL=https://your-development-or-production-api-host